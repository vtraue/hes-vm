import env fn gfx_paint(framebuffer: int, width: int, height: int);
import env fn gfx_clear_buffer_rgb(framebuffer: int, r: int, g: int, b: int);
import env fn gfx_draw_rect_rgb(framebuffer: int, x: int, y: int, width: int, height: int, r: int, g: int, b: int);
import env fn gfx_create_framebuffer() -> int;

export fn init() -> int {
	return gfx_create_framebuffer();
}

export fn run(framebuffer: int, width: int, height: int) {
	gfx_clear_buffer_rgb(framebuffer, 0, 0, 200);
	gfx_draw_rect_rgb(framebuffer, 16, 16, 16, 16, 200, 0, 0);
	gfx_paint(framebuffer, 640, 360);
	return;
}

